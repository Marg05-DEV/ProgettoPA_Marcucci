{
  "compilerOptions": {
    // Layout dei file
    "rootDir": "./src",
    "outDir": "./dist",

    // Impostazioni dell'ambiente
    "module": "nodenext", // Sistema di moduli da utilizzare. 
    "target": "ES2022", // Versione di JavaScript con cui compilare il progetto
    "types": ["jest", "node"],

    // Altri output
    "sourceMap": true, // Genera file .map per mappare i file js ai file ts. Utile per il debug

    // Opzioni di type checking più rigorose
    "noUncheckedIndexedAccess": true, 
    "exactOptionalPropertyTypes": true,

    // Opzioni consigliate
    "strict": true, // Abilita tutti i controlli rigorosi: nessuna variabile Any (nessuna definizione di tipo), gestire null e undefined esplicitamente, verificare i tipi di funzione, ecc.
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  "include": ["src/**/*.ts", "../tests/**/*.ts"], // includi tutti i file .ts nella cartella src (e nelle sottocartelle)
  "exclude": ["node_modules", "dist"] // escludi le cartelle node_modules (dipendenze) e dist (file ts compilati in js)
}
