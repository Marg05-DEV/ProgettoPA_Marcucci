{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    "module": "nodenext", // Mpdule system to use. nod
    "target": "ES2022", // JavaScript version to compile project to
    "types": [],

    // Other Outputs
    "sourceMap": true, // Generate .map files to map js files to ts files for debugging

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true, 
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true, // Enable all strict checking: no Any variables (no type definition), manage null and undefined explicitly, check function types, etc.
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  "include": ["src/**/*.ts"], // include all .ts files in src directory(and subdirectories)
  "exclude": ["node_modules", "dist"] // exclude files in node_modules (dependencies) and dist (compiled ts files in js) directories
}
